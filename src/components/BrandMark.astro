---
import {RACK_MARK_PATH} from '~/lib/brand.mjs';
interface Props {size?:number;}
const {size=32}=Astro.props;
---
<svg width={size} height={size} viewBox="0 0 40 40" fill="currentColor" aria-hidden="true" focusable="false"><path fill-rule="evenodd" d={RACK_MARK_PATH}/></svg>
<style>svg{display:block;flex:none}</style>