---
import '~/styles/global.css';
import Header from '~/components/Header.astro';
import Footer from '~/components/Footer.astro';
import { SITE, absolute, href } from '~/lib/site';
import { personSchema, websiteSchema } from '~/lib/seo';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  noIndex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  isHome?: boolean;
}

const { title, description, ogImage = SITE.defaultOgImage, ogType = 'website', noIndex = false, jsonLd, isHome = false } = Astro.props;

const origin = Astro.site?.origin ?? 'https://mcprack.dev';
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '');
const canonical = `${origin}${path ? path + '/' : '/'}`;
const fullTitle = isHome ? `${SITE.name} · Curated MCP servers by ${SITE.owner.name}` : `${title} · ${SITE.name}`;
const ogImageUrl = ogImage.startsWith('http') ? ogImage : absolute(ogImage, Astro.site);
const schemas = [websiteSchema(Astro.site), personSchema(Astro.site), ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [])];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (t !== 'light' && t !== 'dark') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          document.documentElement.setAttribute('data-theme', t);
        } catch (e) {}
      })();
    </script>
    <noscript><style>.pill-nav{display:flex!important;flex-wrap:wrap}.pill{flex-wrap:wrap}.burger,.theme-toggle{display:none!important}</style></noscript>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#faf8f4" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0b1218" />
    <link rel="apple-touch-icon" href={href('/apple-touch-icon.png')} />
    <link rel="icon" href={href('/favicon.svg')} type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} · Journal`} href={href('/rss.xml')} />
    <link rel="alternate" type="application/json" title="MCP Rack catalog" href={href('/catalog.json')} />
    <link rel="alternate" type="text/plain" title="Information for agents" href={href('/llms.txt')} />
    <link rel="sitemap" href={href('/sitemap-index.xml')} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content={SITE.locale} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={SITE.owner.xHandle} />
    <meta name="twitter:creator" content={SITE.owner.xHandle} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    {schemas.map((schema) => <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="grain" aria-hidden="true"></div>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      // Reveal-on-scroll and copy buttons. Bound once per page load.
      const reveals = document.querySelectorAll<HTMLElement>('.reveal');
      if ('IntersectionObserver' in window && reveals.length) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            }
          },
          { threshold: 0.12, rootMargin: '0px 0px -8% 0px' },
        );
        reveals.forEach((el) => io.observe(el));
      } else {
        reveals.forEach((el) => el.classList.add('is-visible'));
      }

      document.addEventListener('click', async (event) => {
        const btn = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-copy]');
        if (!btn) return;
        const text = btn.dataset.copy ?? '';
        const label = btn.querySelector('[data-copy-label]') ?? btn;
        const original = label.textContent;
        try {
          await navigator.clipboard.writeText(text);
          btn.dataset.done = 'true';
          label.textContent = 'Copied';
        } catch {
          btn.dataset.done = 'false';
          label.textContent = 'Copy unavailable';
        }
        window.setTimeout(() => {
          btn.dataset.done = 'false';
          label.textContent = original;
        }, 1600);
      });
    </script>
  </body>
</html>
