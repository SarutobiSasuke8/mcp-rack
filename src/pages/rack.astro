---
import { getCollection } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import RackCard from '~/components/RackCard.astro';
import { breadcrumbSchema } from '~/lib/seo';

const rack = await getCollection('rack');
---

<BaseLayout title="The rack" description="A shortlist of MCP servers Alexei Udall uses or recommends, with setup links and a practical starting point for each." jsonLd={breadcrumbSchema([{ name: 'Rack', path: '/rack' }], Astro.site)}>
  <section class="container page-head">
    <p class="kicker">Also on the rack</p>
    <h1 class="t-h1">MCP servers I use or recommend</h1>
    <p class="t-lead">A shortlist of tools from other makers, with what each is good for and a link to the maker’s setup guide.</p>
  </section>
  <section class="container">
    <div class="rack-grid stagger">
      {rack.map((r) => <RackCard item={r.data} />)}
    </div>
  </section>
</BaseLayout>

<style>
  .page-head { padding: 56px 0 32px; }
  @media (min-width: 1024px) { .page-head { padding: 88px 0 40px; } }
  .page-head .t-lead { margin-top: 18px; max-width: 62ch; }
  .rack-grid { display: grid; gap: 16px; padding-bottom: 24px; }
  @media (min-width: 640px) { .rack-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .rack-grid { grid-template-columns: repeat(3, 1fr); } }
</style>
