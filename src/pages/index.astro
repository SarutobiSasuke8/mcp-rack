---
import { getCollection } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import ServerRow from '~/components/ServerRow.astro';
import RackCard from '~/components/RackCard.astro';
import PostCard from '~/components/PostCard.astro';
import { SITE, href } from '~/lib/site';
import { itemListSchema } from '~/lib/seo';
const servers = (await getCollection('servers')).sort((a,b) => a.data.order-b.data.order);
const rack = await getCollection('rack');
const posts = (await getCollection('posts', ({data}) => !data.draft)).sort((a,b) => b.data.pubDate.valueOf()-a.data.pubDate.valueOf());
const packaged = servers.filter(s => s.data.package).length;
---
<BaseLayout title={SITE.name} description={SITE.description} isHome jsonLd={itemListSchema(servers.map(s=>s.data),Astro.site)}>
  <section class="rack-hero" aria-labelledby="hero-title">
    <img class="hero-art" src={href('/rack-hero.webp')} width="1536" height="1024" alt="" fetchpriority="high" />
    <div class="container hero-inner">
      <div class="hero-copy">
        <p class="eyebrow"><span></span> An independent MCP collection</p>
        <h1 id="hero-title">Good tools.<br />Real work.<br /><em>A considered rack.</em></h1>
        <p class="hero-description">MCP servers built for a purpose. A small selection from other makers. Practical notes on putting them to work.</p>
        <div class="hero-actions"><a class="btn hero-primary" href={href('/servers')}>Explore the collection <span aria-hidden="true">↗</span></a><a class="hero-secondary" href={href('/rack')}>See the curated rack <span aria-hidden="true">→</span></a></div>
        <p class="hero-byline">Built and selected by <a href={SITE.owner.url}>Alexei Udall</a></p>
      </div>
      <div class="object-caption" aria-hidden="true"><span>RACK / 001</span><span>A place for useful connections.</span></div>
    </div>
  </section>
  <div class="collection-strip"><div class="container strip-inner"><p><strong>{servers.length}</strong> own projects</p><p><strong>{rack.length}</strong> curated picks</p><p><strong>{packaged}</strong> published packages</p><a href={href('/agents')}>Readable by humans. Accessible to agents. <span aria-hidden="true">↗</span></a></div></div>
  <section class="section container" aria-labelledby="collection-title">
    <div class="section-head"><div><p class="kicker">01 / From the workbench</p><h2 class="t-h2" id="collection-title">Tools with a job to do.</h2></div><a class="text-link" href={href('/servers')}>All projects <span aria-hidden="true">↗</span></a></div>
    <p class="section-intro">Image editing, web content, job discovery and agent coordination. Open-source projects with the details you need to decide what fits.</p>
    <ol class="board">{servers.slice(0,3).map((s,i)=><ServerRow server={s.data} index={i} />)}</ol>
    <div class="collection-note"><span class="mono">OPEN SOURCE / STATUS SHOWN</span><p>Packaged tools sit alongside early projects. Alpha means alpha, and a registry entry is not a security endorsement.</p></div>
  </section>
  <section class="curation-section"><div class="container curation-inner"><div><p class="kicker">02 / The selection</p><h2 class="t-h2">A smaller rack.<br /><em>A clearer choice.</em></h2><p class="t-lead">The useful question is what earns a place in your workflow. These are servers from other makers that are part of mine.</p><a class="text-link" href={href('/standards')}>How selection works <span aria-hidden="true">↗</span></a></div><div class="curation-principles"><div><span>01</span><h3>A specific use</h3><p>Every pick explains the work it helps with.</p></div><div><span>02</span><h3>A direct source</h3><p>Go straight to the maker for setup, access and current limits.</p></div><div><span>03</span><h3>An honest boundary</h3><p>Personal use is a recommendation, not a certification.</p></div></div></div></section>
  <section class="section container" aria-labelledby="rack-title"><div class="section-head"><div><p class="kicker">Selected from other makers</p><h2 class="t-h2" id="rack-title">Also on the rack.</h2></div><a class="text-link" href={href('/rack')}>All {rack.length} picks <span aria-hidden="true">↗</span></a></div><div class="rack-grid">{rack.slice(0,4).map(r=><RackCard item={r.data}/>)}</div></section>
  <section class="journal-section section container" aria-labelledby="journal-title"><div class="section-head"><div><p class="kicker">03 / The journal</p><h2 class="t-h2" id="journal-title">Notes from putting MCP to work.</h2></div><a class="text-link" href={href('/blog')}>Read the journal <span aria-hidden="true">↗</span></a></div><div class="journal-grid">{posts.slice(0,3).map(p=><PostCard post={p}/>)}</div></section>
  <section class="container"><div class="agent-band"><div><p class="kicker">For your next agent session</p><h2 class="t-h2">Take the rack with you.</h2><p>Structured listings, plain-text documentation and a feed. No account or browser automation required.</p></div><div class="agent-links"><a href={href('/agents')}>Agent guide <span>↗</span></a><a href={href('/catalog.json')}>catalog.json <span>↗</span></a><a href={href('/llms-full.txt')}>llms-full.txt <span>↗</span></a></div></div></section>
  <section class="container maker-invite"><p class="kicker">For MCP makers</p><h2 class="t-h2">Built something that belongs here?</h2><p>Show the workflow, the source and the limitations. Suggestions are reviewed for fit.</p><a class="btn btn-primary" href={href('/submit')}>Suggest a server <span aria-hidden="true">↗</span></a></section>
</BaseLayout>
<style>
  .rack-hero{position:relative;isolation:isolate;overflow:hidden;background:#101415;color:#f5f3ed;margin-top:0}
  .hero-art{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center;z-index:-2}
  .rack-hero::after{content:'';position:absolute;inset:0;z-index:-1;background:linear-gradient(90deg,rgba(12,17,18,.93) 0%,rgba(12,17,18,.75) 34%,rgba(12,17,18,.05) 75%)}
  .hero-inner{position:relative;padding-block:95px 76px;min-height:670px;display:flex;align-items:center}
  .hero-copy{max-width:660px}.eyebrow{font:11px var(--font-mono);letter-spacing:.16em;text-transform:uppercase;color:#a5c9bf;display:flex;align-items:center;gap:12px;margin:0 0 30px}.eyebrow span{width:6px;height:6px;border-radius:50%;background:#a5c9bf}
  h1{font-size:clamp(3rem,5.2vw,5.4rem);font-weight:480;letter-spacing:-.055em;line-height:1.04;margin:0}h1 em{font-family:Georgia,serif;font-weight:400;letter-spacing:-.055em;color:#a9c7ba}
  .hero-description{max-width:40ch;color:#c4ccca;font-size:18px;line-height:1.7;margin:30px 0}.hero-actions{display:flex;align-items:center;gap:26px;flex-wrap:wrap}.hero-primary{background:#c5d9cd;color:#152c26;border-radius:4px;min-height:48px;gap:24px}.hero-primary:hover{background:#e1ece5}.hero-secondary{font-size:14px;text-decoration:none;color:#e5e9e6}.hero-secondary span{margin-left:12px}.hero-byline{font-size:12px;color:#a7b1ad;margin:32px 0 0}.hero-byline a{color:#d1dbd5}
  .object-caption{position:absolute;right:40px;bottom:30px;display:grid;gap:7px;font:10px var(--font-mono);letter-spacing:.1em;color:#a7b1ad}.object-caption span:first-child{color:#d1dbd5}
  .collection-strip{border-bottom:1px solid var(--line);background:var(--paper-2)}.strip-inner{display:flex;align-items:center;gap:38px;min-height:82px;flex-wrap:wrap;padding-block:18px}.strip-inner p{margin:0;font-size:12px;color:var(--ink-2)}.strip-inner strong{font-size:20px;color:var(--ink);margin-right:7px;font-weight:500}.strip-inner a{margin-left:auto;font-size:12px;text-decoration:none;color:var(--ink-2)}
  .board{list-style:none;margin:28px 0 0;padding:0}.section-intro{max-width:62ch;color:var(--ink-2);line-height:1.7;margin-top:-10px}.collection-note{display:flex;justify-content:space-between;gap:30px;border-bottom:1px solid var(--line);padding:20px 0}.collection-note span{font-size:10px;letter-spacing:.08em;flex-shrink:0;color:var(--ink-3);padding-top:4px}.collection-note p{max-width:60ch;margin:0;color:var(--ink-3);font-size:12px}
  .curation-section{background:var(--paper-2);border-block:1px solid var(--line)}.curation-inner{display:grid;grid-template-columns:1fr 1fr;gap:100px;padding-block:80px}.curation-inner .t-h2{font-size:clamp(2.4rem,3.5vw,3.8rem);line-height:1.1}.curation-inner em{font-family:Georgia,serif;font-weight:400;color:var(--accent)}.curation-inner .t-lead{margin:24px 0;font-size:16px;max-width:42ch}.curation-principles{display:grid}.curation-principles>div{display:grid;grid-template-columns:36px 1fr;border-bottom:1px solid var(--line-strong);padding:22px 0;gap:8px 12px}.curation-principles>div:first-child{padding-top:0}.curation-principles span{grid-row:span 2;font:11px var(--font-mono);color:var(--accent);padding-top:5px}.curation-principles h3{font-size:19px;font-weight:500;margin:0}.curation-principles p{margin:0;color:var(--ink-2);font-size:14px}
  .rack-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px}.journal-section{border-top:1px solid var(--line)}.journal-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}.agent-band{display:grid;grid-template-columns:1.4fr 1fr;gap:64px;background:var(--paper-2);border:1px solid var(--line);padding:48px}.agent-band p{color:var(--ink-2);max-width:46ch}.agent-links{display:grid;align-content:center}.agent-links a{display:flex;justify-content:space-between;padding:16px 0;border-bottom:1px solid var(--line-strong);font:14px var(--font-mono);text-decoration:none}.agent-links a:hover{color:var(--accent)}.maker-invite{text-align:center;padding-block:90px 20px}.maker-invite p:not(.kicker){color:var(--ink-2)}.maker-invite .btn{margin-top:16px}
  @media(max-width:900px){.hero-inner{min-height:620px;padding-block:70px}.hero-art{object-position:60% center}.object-caption{display:none}.curation-inner{gap:40px}.rack-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.strip-inner{gap:18px}.strip-inner a{width:100%;margin:0}.journal-grid{grid-template-columns:1fr}.agent-band{gap:30px;padding:30px}}
  @media(max-width:600px){.hero-inner{min-height:660px;padding-block:65px}.rack-hero::after{background:linear-gradient(90deg,rgba(12,17,18,.93),rgba(12,17,18,.65))}.hero-art{object-position:70% center}.hero-copy{max-width:100%}.hero-description{font-size:16px;max-width:32ch}h1{font-size:clamp(2.8rem,11vw,3.9rem)}.eyebrow{font-size:9px;letter-spacing:.1em}.hero-actions{gap:20px}.collection-note{flex-direction:column;gap:10px}.curation-inner,.agent-band{grid-template-columns:1fr}.curation-inner{padding-block:55px}.rack-grid{grid-template-columns:1fr}.strip-inner{gap:14px}.strip-inner p{font-size:10px}.strip-inner strong{font-size:17px;margin-right:3px}.maker-invite{padding-top:65px}}
</style>
