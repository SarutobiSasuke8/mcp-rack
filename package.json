{
  "name": "mcp-rack",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "MCP Rack: every MCP server Alexei Udall has published, the servers he runs alongside them, and release notes.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/generate-og.mjs && astro build && npm run check:output",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "style": "node scripts/check-style.mjs",
    "fonts": "node scripts/copy-fonts.mjs",
    "og": "node scripts/generate-og.mjs",
    "verify": "npm run style && npm run check && npm run build",
    "check:output": "node scripts/check-output.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.0",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/geist": "^5.2.0",
    "@fontsource-variable/geist-mono": "^5.2.0",
    "astro": "^7.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "sharp": "^0.35.4",
    "typescript": "^5.9.3"
  }
}
