{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mcprack.dev/catalog.schema.json",
  "title": "MCP Rack catalog v1.2",
  "type": "object",
  "required": [
    "schemaVersion",
    "generatedAt",
    "generatedAtMeaning",
    "name",
    "description",
    "website",
    "editorialPolicy",
    "provenance",
    "servers",
    "curated",
    "articles"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.2.0"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "generatedAtMeaning": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "website": {
      "type": "string",
      "format": "uri"
    },
    "editorialPolicy": {
      "type": "string",
      "format": "uri"
    },
    "provenance": {
      "type": "string"
    },
    "servers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "slug",
          "name",
          "listingType",
          "softwareType",
          "url",
          "markdownUrl",
          "reviewedAt",
          "repo",
          "docs",
          "transport",
          "status",
          "package",
          "install",
          "license",
          "tags",
          "review",
          "supportedScope",
          "maturityEvidence"
        ],
        "properties": {
          "slug": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "listingType": {
            "const": "owner-built"
          },
          "softwareType": {
            "enum": [
              "mcp-server",
              "companion-tool"
            ]
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "markdownUrl": {
            "type": "string",
            "format": "uri"
          },
          "reviewedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "repo": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          },
          "docs": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          },
          "transport": {
            "type": "string"
          },
          "availability": {
            "type": [
              "string",
              "null"
            ]
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "interestUrl": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          },
          "hosted": {
            "$ref": "#/$defs/hosted"
          },
          "status": {
            "enum": [
              "alpha",
              "beta",
              "preview",
              "experimental",
              "stable"
            ]
          },
          "package": {
            "type": [
              "object",
              "null"
            ]
          },
          "install": {
            "type": [
              "string",
              "null"
            ]
          },
          "license": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "review": {
            "$ref": "#/$defs/review"
          },
          "supportedScope": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "maturityEvidence": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "reviewedAt": {
                  "type": "null"
                }
              }
            },
            "then": {
              "properties": {
                "review": {
                  "type": "null"
                }
              }
            },
            "else": {
              "properties": {
                "review": {
                  "type": "object"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "stable"
                }
              }
            },
            "then": {
              "properties": {
                "reviewedAt": {
                  "type": "string"
                },
                "review": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "runtime"
                    }
                  }
                },
                "supportedScope": {
                  "type": "string",
                  "minLength": 1
                },
                "maturityEvidence": {
                  "type": "string",
                  "format": "uri"
                }
              }
            }
          }
        ]
      }
    },
    "curated": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "slug",
          "name",
          "by",
          "url",
          "useCase",
          "listingType",
          "reviewedAt",
          "independentAudit",
          "review",
          "selectionBasis"
        ],
        "properties": {
          "slug": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "by": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "useCase": {
            "type": "string"
          },
          "listingType": {
            "const": "curated"
          },
          "reviewedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "independentAudit": {
            "const": false
          },
          "review": {
            "$ref": "#/$defs/review"
          },
          "selectionBasis": {
            "type": "string",
            "minLength": 1
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "reviewedAt": {
                  "type": "null"
                }
              }
            },
            "then": {
              "properties": {
                "review": {
                  "type": "null"
                }
              }
            },
            "else": {
              "properties": {
                "review": {
                  "type": "object"
                }
              }
            }
          }
        ]
      }
    },
    "articles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "slug",
          "title",
          "url",
          "markdownUrl",
          "pubDate",
          "category"
        ],
        "properties": {
          "slug": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "markdownUrl": {
            "type": "string",
            "format": "uri"
          },
          "pubDate": {
            "type": "string",
            "format": "date-time"
          },
          "category": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "review": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "kind",
        "summary",
        "evidence"
      ],
      "properties": {
        "kind": {
          "enum": [
            "metadata",
            "runtime"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    },
    "hosted": {
      "description": "Hosted endpoint or live demo. Connect only when live is true; live false means coming soon and the site does not link it.",
      "type": [
        "object",
        "null"
      ],
      "required": [
        "url",
        "label",
        "kind",
        "live"
      ],
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "kind": {
          "enum": [
            "remote-mcp",
            "demo"
          ]
        },
        "live": {
          "type": "boolean"
        }
      }
    }
  }
}
